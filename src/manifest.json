{
  "manifest_version": 3,
  "name": "Lateread",
  "version": "1.0.0",
  "description": "Save links and actually read them: a board with Now, Next, Later and Read.",
  "permissions": ["storage", "activeTab", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to read later",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
