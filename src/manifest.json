{
  "manifest_version": 3,
  "name": "Owlater",
  "version": "1.0.0",
  "description": "Save links and videos, and actually get to them: a board with Now, Next, Later and Read.",
  "permissions": ["storage", "activeTab", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Owlater",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
